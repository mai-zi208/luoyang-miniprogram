<view class="screen map-page">
  <image class="map-ink" src="/assets/palace-4.webp" mode="aspectFit" />
  <view class="kicker">神都 · 点位</view>
  <view class="title lg">游历地图</view>
  <map wx:if="{{visible}}" id="tour-map" class="map" latitude="{{latitude}}" longitude="{{longitude}}" scale="12"
    markers="{{markers}}" include-points="{{points}}" bindmarkertap="selectMarker" bindupdated="ready" binderror="mapError" />
  <button wx:if="{{mapNotice}}" class="secondary retry" hover-class="pressed" bindtap="retryMap">{{mapNotice}}</button>
  <view class="muted map-note">景点坐标为参考点位，出行前请核对实际入口。</view>

  <view class="brief {{flipping ? 'flipping' : ''}}">
    <view class="row head">
      <view class="who">
        <view class="kicker" wx:if="{{active}}">第 {{activeNo}} 站</view>
        <view class="heading">{{active ? active.name : '点标记或站名看古今'}}</view>
      </view>
      <navigator wx:if="{{active}}" class="secondary small" hover-class="pressed" url="/pages/story/index?id={{active.id}}">打开听卷</navigator>
    </view>
    <view class="chips">
      <view wx:for="{{route}}" wx:for-item="s" wx:for-index="i" wx:key="id" class="chip-stop {{active && active.id === s.id ? 'on' : ''}}" style="animation-delay:{{i * 45}}ms" hover-class="pressed" data-id="{{s.id}}" bindtap="selectStop">{{i + 1}} {{s.short || s.name}}</view>
    </view>
    <block wx:if="{{active}}">
      <view class="sec">
        <view class="sec-t">时代变迁</view>
        <text class="sec-b">{{active.era}}</text>
      </view>
      <view class="sec">
        <view class="sec-t">今天 · 周边</view>
        <view wx:for="{{active.nearby}}" wx:for-item="n" wx:key="kind" class="near"><text class="tag">{{n.kind}}</text><text class="nb">{{n.text}}</text></view>
      </view>
    </block>
    <view wx:else class="muted hint">点上任一站，朕给你讲它的古与今。</view>
    <button class="primary block locate" hover-class="pressed" loading="{{locating}}" disabled="{{locating || !visible}}" bindtap="locate">我的位置</button>
    <view wx:if="{{canOpenSettings}}" class="errrow">
      <view class="muted">{{notice}}</view>
      <button class="text-btn" hover-class="pressed" bindtap="openSettings">打开定位设置</button>
    </view>
    <view wx:elif="{{notice}}" class="notice">{{notice}}</view>
  </view>

  <button class="primary go-story" hover-class="pressed" disabled="{{!active}}" bindtap="goStory">查看景点故事</button>
</view>
