.map-page { position:relative;padding-bottom:calc(var(--s-4) + env(safe-area-inset-bottom)); }
.map-ink {
  position:absolute;top:0;left:0;width:100%;height:210rpx;
  opacity:.10;mix-blend-mode:lighten;pointer-events:none;
}
.map { width:100%;height:40vh;min-height:420rpx;margin-top:var(--s-3);background:var(--ink-1);border:1px solid var(--line-2);border-radius:var(--r-md);animation:rise var(--t-3) 70ms var(--ease) backwards }
.retry { margin-top:var(--s-2); }
.map-page .title { animation:rise var(--t-3) var(--ease) backwards }
.map-note { margin-top:20rpx; }

/* 现代介绍框：站名与听卷入口在上，站名 chips 切换点位，再下是时代变迁与今天周边两节。 */
.brief {
  margin-top:var(--s-3);padding:var(--s-4);
  background:var(--ink-1);border:1px solid var(--line-2);border-radius:var(--r-md);
  box-shadow:var(--hl);
  animation:rise var(--t-3) 140ms var(--ease) backwards;
}
.brief.flipping { animation:rise var(--t-2) var(--ease-back) backwards }
.head { align-items:flex-start;margin-bottom:var(--s-2); }
.who { flex:1;min-width:0; }
.who .kicker { margin-bottom:6rpx; }
.head .small { flex:0 0 auto;width:max-content; }
.chips { display:flex;flex-wrap:wrap;gap:10rpx;margin-bottom:var(--s-3); }
.chip-stop {
  padding:8rpx 18rpx;font-size:20rpx;color:var(--text-mid);
  background:var(--ink-0);border:1px solid var(--line-1);border-radius:999rpx;
  transition:background var(--t-2),color var(--t-2),border-color var(--t-2);
  animation:rise var(--t-3) var(--ease) backwards;
}
.chip-stop.on { background:var(--gold-500);border-color:var(--gold-500);color:var(--on-gold); }
.sec { border-top:1px solid var(--line-1);margin-top:var(--s-2);padding-top:var(--s-2); }
.sec-t { font-size:var(--f-kicker);letter-spacing:4rpx;color:var(--gold-500);margin-bottom:10rpx; }
.sec-b { display:block;white-space:pre-wrap;word-break:break-word;line-height:1.85;font-size:var(--f-body);color:var(--text-mid); }
.near { display:flex;align-items:flex-start;gap:12rpx;margin-top:12rpx;font-size:var(--f-caption);line-height:1.7;color:var(--text-mid); }
.near .tag {
  flex:0 0 40rpx;width:40rpx;height:40rpx;line-height:38rpx;text-align:center;
  border:1px solid var(--line-2);border-radius:50%;color:var(--gold-300);font-size:20rpx;
}
.near .nb { flex:1;min-width:0; }
.hint { margin-bottom:var(--s-3); }
.locate { margin-top:var(--s-3); }
.errrow { display:flex;flex-direction:column;align-items:flex-start;gap:var(--s-1);margin-top:var(--s-2); }
.errrow .muted { flex:1;min-width:0;color:var(--alert); }
