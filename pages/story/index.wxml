<view class="screen story">
  <block wx:if="{{stop}}">
    <view class="kicker">神都 · 听卷</view>
    <view class="title lg">{{stop.name}}</view>
    <image class="hero" mode="aspectFill" src="/assets/palace-{{stop.id > 5 ? 1 : stop.id}}.webp" />
    <narrator stop-id="{{stop.id}}" />
    <view class="card">
      <view class="row"><view class="heading">此站讲解</view><view class="chip">底稿</view></view>
      <view class="passage">{{stop.story}}</view>
      <view class="src" hover-class="pressed" data-url="{{stop.source}}" bindtap="copySource"><text class="lb">来源</text><text class="link">{{sourceHost}}</text></view>
    </view>
    <view wx:if="{{stop.legend}}" class="card featured">
      <view class="row"><view class="heading">传说</view><view class="chip"><view class="dot peony"></view>非正史</view></view>
      <view class="passage">{{stop.legend}}</view>
      <view class="src" hover-class="pressed" data-url="{{stop.legendSource}}" bindtap="copySource"><text class="lb">来源</text><text class="link">{{legendHost}}</text></view>
    </view>
    <view wx:else class="card">
      <view class="row"><view class="heading">传说</view><view class="chip">无</view></view>
      <view class="muted tip">此处暂无可靠传说记录，不作演绎。</view>
    </view>
  </block>
  <view wx:else class="card">
    <view class="muted">这个景点的故事暂时无法打开。</view>
    <navigator class="secondary" hover-class="pressed" open-type="reLaunch" url="/pages/choose/index">返回游历选择</navigator>
  </view>
</view>
